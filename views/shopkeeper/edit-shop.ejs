<!DOCTYPE html>
<html lang="en">
<head>
  <title>Edit <%= shop.name %> — Chair&Queue</title>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container">
    <div class="form-card wide">
      <h2>Edit shop</h2>
      <p class="lead">Update your shop's details, photo, or location.</p>

      <%- include('../partials/flash') %>

      <form action="/shopkeeper/shops/<%= shop._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
        <div class="field">
          <label for="name">Shop name</label>
          <input type="text" id="name" name="name" value="<%= shop.name %>" required>
        </div>
        <div class="field">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="3"><%= shop.description %></textarea>
        </div>
        <div class="field">
          <label for="address">Address</label>
          <input type="text" id="address" name="address" value="<%= shop.address %>" required>
        </div>
        <div class="field">
          <label>Current photo</label>
          <img id="imagePreview"src="<%= shop.image.url %>" alt="<%= shop.name %>" style="width:100%; max-height:280px; object-fit:contain; background:var(--parchment-dim); border-radius:4px; margin-bottom:10px;">
          <label for="image">Replace photo (optional)</label>
          <input type="file" id="image" name="image" accept="image/*">
        </div>

        <div class="field">
          <label>Location</label>
          <div class="hint">Click the map to move the pin.</div>
          <div id="map" style="margin-top:10px;"></div>
          <input type="hidden" id="lng" name="lng" value="<%= shop.location.coordinates[0] %>" required>
          <input type="hidden" id="lat" name="lat" value="<%= shop.location.coordinates[1] %>" required>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Save changes</button>
      </form>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script>
    document.getElementById('image').addEventListener('change', function (e) {
      const file = e.target.files[0];
      if (!file) return;
      const preview = document.getElementById('imagePreview');
      preview.src = URL.createObjectURL(file);
    });
  </script>

  <script src="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.js"></script>
  <script>
    mapboxgl.accessToken = "<%= mapboxToken %>";
    const startLng = <%= shop.location.coordinates[0] %>;
    const startLat = <%= shop.location.coordinates[1] %>;

    const map = new mapboxgl.Map({
      container: 'map',
      style: 'mapbox://styles/mapbox/streets-v12',
      center: [startLng, startLat],
      zoom: 14
    });

    let marker = new mapboxgl.Marker({ color: '#c9622a', draggable: true })
      .setLngLat([startLng, startLat])
      .addTo(map);

    function updateFields(lngLat) {
      document.getElementById('lng').value = lngLat.lng;
      document.getElementById('lat').value = lngLat.lat;
    }

    marker.on('dragend', () => updateFields(marker.getLngLat()));

    map.on('click', (e) => {
      marker.setLngLat(e.lngLat);
      updateFields(e.lngLat);
    });
  </script>
</body>
</html>

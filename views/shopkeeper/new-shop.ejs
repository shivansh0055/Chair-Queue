<!DOCTYPE html>
<html lang="en">
<head>
  <title>List a new shop — Chair&Queue</title>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container">
    <div class="form-card wide">
      <h2>List your saloon</h2>
      <p class="lead">Add a photo, address, and drop a pin at your exact location.</p>

      <%- include('../partials/flash') %>

      <form action="/shopkeeper/shops" method="POST" enctype="multipart/form-data">
        <div class="field">
          <label for="name">Shop name</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div class="field">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="3" placeholder="Tell customers what makes your saloon worth visiting"></textarea>
        </div>
        <div class="field">
          <label for="address">Address</label>
          <input type="text" id="address" name="address" required placeholder="Street, city, state">
        </div>
        <div class="field">
          <label for="image">Shop photo</label>
          <input type="file" id="image" name="image" accept="image/*" required>
        </div>

        <div class="field">
          <label>Pin your location on the map</label>
          <div class="hint">Search or click on the map to place the pin. This is what customers will see.</div>
          <div id="map" style="margin-top:10px;"></div>
          <input type="hidden" id="lng" name="lng" required>
          <input type="hidden" id="lat" name="lat" required>
        </div>

        <button type="submit" class="btn btn-primary btn-block">List my shop</button>
      </form>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script src="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.js"></script>
  <script>
    mapboxgl.accessToken = "<%= mapboxToken %>";

    const map = new mapboxgl.Map({
      container: 'map',
      style: 'mapbox://styles/mapbox/streets-v12',
      center: [77.2090, 28.6139], // default center; adjust as needed
      zoom: 11
    });

    let marker = null;

    function placeMarker(lngLat) {
      if (marker) marker.remove();
      marker = new mapboxgl.Marker({ color: '#c9622a', draggable: true })
        .setLngLat(lngLat)
        .addTo(map);

      document.getElementById('lng').value = lngLat.lng;
      document.getElementById('lat').value = lngLat.lat;

      marker.on('dragend', () => {
        const pos = marker.getLngLat();
        document.getElementById('lng').value = pos.lng;
        document.getElementById('lat').value = pos.lat;
      });
    }

    map.on('click', (e) => placeMarker(e.lngLat));

    // Try to center on user's browser location if available
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition((pos) => {
        map.setCenter([pos.coords.longitude, pos.coords.latitude]);
      });
    }
  </script>
</body>
</html>
